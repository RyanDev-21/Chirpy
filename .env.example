# copy to .env and fill in
ADDR=:8080
PLATFORM=dev
DB_URL=postgres://chirpy:chirpy@localhost:5432/chirpy?sslmode=disable
DB_MAX_CONNS=10
DB_MAX_IDLE_TIME=2m
MIGRATE_ON_START=true
# PORT (set by Render) wins over ADDR
# either a URL (rediss:// for TLS, e.g. Upstash) ...
REDIS_URL=
# ... or the individual fields
REDIS_ADDR=localhost:6379
REDIS_USR=
REDIS_PASS=
REDIS_DB=0
REDIS_POOL_SIZE=0            # 0 = 10 per CPU
QUEUE_REDIS_POOL_SIZE=16
# redis = durable Redis Streams; memory = in-process (free tiers billed per command)
QUEUE_BACKEND=redis
# at least 32 characters, e.g. `openssl rand -hex 32`
SECRET=
# leave both empty to serve plain HTTP behind a TLS-terminating proxy
TLS_CERT_FILE=
TLS_KEY_FILE=
CORS_ALLOWED_ORIGINS=http://localhost:3000
# number of reverse proxies in front of the server (Render: 1, Caddy: 1, none: 0);
# picks the X-Forwarded-For entry the closest trusted proxy added
TRUSTED_PROXIES=0
# debug | info | warn | error ; json for production, text is easier to read locally
LOG_LEVEL=info
LOG_FORMAT=json
# email codes; without a key, PLATFORM=dev prints emails to the log
RESEND_API_KEY=
MAIL_FROM=Chirpy <no-reply@mail.ponypigeon.com>
# comma-separated OAuth client IDs Google ID tokens may be issued to
# (for Android: the *Web* client ID passed as serverClientId)
GOOGLE_CLIENT_IDS=
