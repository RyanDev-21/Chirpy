# copy to .env and fill in
ADDR=:8080
PLATFORM=dev
DB_URL=postgres://chirpy:chirpy@localhost:5432/chirpy?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_USR=
REDIS_PASS=
REDIS_DB=0
# at least 32 characters, e.g. `openssl rand -hex 32`
SECRET=
GEMINI_API_KEY=
# leave both empty to serve plain HTTP behind a TLS-terminating proxy
TLS_CERT_FILE=
TLS_KEY_FILE=
CORS_ALLOWED_ORIGINS=http://localhost:3000
# only behind a proxy you control that overwrites X-Forwarded-For
TRUST_PROXY_HEADERS=false
