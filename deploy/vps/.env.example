REDIS_PASSWORD=
SECRET=                      # JWT secret: the SAME value as on Render, or everyone is signed out

API_DOMAIN=api.ponypigeon.com
PLATFORM=prod
LOG_FORMAT=json

# --- copied from Render ---
CORS_ALLOWED_ORIGINS=https://chirpy.ponypigeon.com
GOOGLE_CLIENT_IDS=
